# Copy this file, replace every example value, and keep it outside source
# control if it contains environment-sensitive information.
#
# Nodes are ordered: the first N become stacked control-plane/etcd members and
# all remaining nodes become tainted-free Spark workers.
NODE_HOSTS=(
  k8s-control-01.example.invalid
  k8s-control-02.example.invalid
  k8s-control-03.example.invalid
  spark-worker-01.example.invalid
  spark-worker-02.example.invalid
  spark-worker-03.example.invalid
)

NODE_IPS=(
  192.0.2.11
  192.0.2.12
  192.0.2.13
  192.0.2.21
  192.0.2.22
  192.0.2.23
)

# This name or IP must already provide a TCP load balancer or floating virtual
# IP on port 6443. It must not identify one individual control-plane machine.
CONTROL_PLANE_ENDPOINT=k8s-api.example.invalid:6443
CLUSTER_NAME=gemius-spark
POD_CIDR=192.168.0.0/16
SERVICE_CIDR=10.96.0.0/12
REMOTE_USER=root
REMOTE_INSTALL_DIR=/opt/gemius-kub
