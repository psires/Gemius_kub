# Nodes are ordered deliberately. The first N entries become control-plane
# nodes, where N is supplied to orchestrate.sh with --control-planes. The rest
# become Spark workers. Keep the host and IP arrays aligned.
NODE_HOSTS=(
  spark-dev-02-worker-09.archeo.gem.lan
  spark-dev-02-worker-10.archeo.gem.lan
  spark-dev-02-worker-11.archeo.gem.lan
  spark-dev-02-worker-12.archeo.gem.lan
)

NODE_IPS=(
  10.21.3.234
  10.21.3.235
  10.21.3.237
  10.21.3.238
)

# This endpoint is valid only for the current N=1 cluster. An N>1 deployment
# must replace it with a stable TCP load-balancer or virtual-IP endpoint that
# forwards port 6443 to every selected control-plane node.
CONTROL_PLANE_ENDPOINT=spark-dev-02-worker-09.archeo.gem.lan:6443
CLUSTER_NAME=gemius-spark
POD_CIDR=192.168.0.0/16
SERVICE_CIDR=10.96.0.0/12
REMOTE_USER=root
REMOTE_INSTALL_DIR=/opt/gemius-kub
CONTAINERD_ROOT=/mnt/ssd1/containerd
KUBELET_ROOT=/mnt/ssd2/kubelet
REQUIRED_STORAGE_MOUNTS=/mnt/ssd1:/mnt/ssd2
