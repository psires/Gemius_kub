# ATM production cluster: three stacked control-plane/etcd members followed by
# five Spark workers. Keep these arrays aligned and ordered.
NODE_HOSTS=(
  spark1w4-atm-prod.gem.lan
  spark1w5-atm-prod.gem.lan
  spark1w6-atm-prod.gem.lan
  spark1w7-atm-prod.gem.lan
  spark1w8-atm-prod.gem.lan
  spark1w9-atm-prod.gem.lan
  spark1w10-atm-prod.gem.lan
  spark1w11-atm-prod.gem.lan
)

NODE_IPS=(
  10.21.2.206
  10.21.2.207
  10.21.2.208
  10.21.2.209
  10.21.1.65
  10.21.1.253
  10.21.2.77
  10.21.2.78
)

# Reserved by the environment owner for kube-vip control-plane HA.
CONTROL_PLANE_ENDPOINT=10.21.2.139:6443
KUBE_VIP_ADDRESS=10.21.2.139
KUBE_VIP_INTERFACE=ens3

CLUSTER_NAME=gemius-spark-atm-prod
POD_CIDR=192.168.0.0/16
SERVICE_CIDR=10.96.0.0/12
REMOTE_USER=root
REMOTE_INSTALL_DIR=/opt/gemius-kub

CONTAINERD_ROOT=/var/lib/containerd
KUBELET_ROOT=/var/lib/kubelet
REQUIRED_STORAGE_MOUNTS=/
